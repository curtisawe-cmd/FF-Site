{
  "rules": {
    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth.token.email === 'curtisawe@gmail.com'"
      }
    },
    "league": {
      "main": {
        "settings": {
          ".read": "auth != null",
          ".write": "auth != null && (auth.token.email === 'curtisawe@gmail.com' || root.child('admins').child(auth.uid).val() === true)"
        },
        "draft": {
          ".read": "auth != null",
          ".write": "auth != null && (auth.token.email === 'curtisawe@gmail.com' || root.child('admins').child(auth.uid).val() === true)"
        },
        "teamData": {
          ".read": "auth != null",
          "$ti": {
            ".write": "auth != null && (auth.token.email === 'curtisawe@gmail.com' || root.child('admins').child(auth.uid).val() === true || root.child('claims').child($ti).val() === auth.uid)"
          }
        },
        "teamMoves": {
          ".read": "auth != null",
          ".write": "auth != null && (auth.token.email === 'curtisawe@gmail.com' || root.child('admins').child(auth.uid).val() === true)",
          "$ti": {
            ".write": "auth != null && (auth.token.email === 'curtisawe@gmail.com' || root.child('admins').child(auth.uid).val() === true || root.child('claims').child($ti).val() === auth.uid)"
          }
        },
        "transactions": {
          ".read": "auth != null",
          "$txid": {
            ".write": "auth != null && ((!data.exists() && newData.child('by').val() === auth.uid) || auth.token.email === 'curtisawe@gmail.com' || root.child('admins').child(auth.uid).val() === true)"
          }
        },
        "pushMarks": {
          ".read": "auth != null",
          "$mark": {
            ".write": "auth != null && (!data.exists() || auth.token.email === 'curtisawe@gmail.com' || root.child('admins').child(auth.uid).val() === true)"
          }
        },
        "liveScores": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "chat": {
          ".read": "auth != null",
          ".write": "auth != null && (auth.token.email === 'curtisawe@gmail.com' || root.child('admins').child(auth.uid).val() === true)",
          "$msgId": {
            ".write": "auth != null && (auth.token.email === 'curtisawe@gmail.com' || root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.child('uid').val() === auth.uid))"
          }
        },
        "polls": {
          ".read": "auth != null",
          "$pid": {
            ".write": "auth != null && (auth.token.email === 'curtisawe@gmail.com' || root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.child('createdByUid').val() === auth.uid) || (data.exists() && data.child('createdByUid').val() === auth.uid))"
          }
        },
        "pollVotes": {
          ".read": "auth != null",
          "$pid": {
            ".write": "auth != null && (auth.token.email === 'curtisawe@gmail.com' || root.child('admins').child(auth.uid).val() === true)",
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'curtisawe@gmail.com' || root.child('admins').child(auth.uid).val() === true) && root.child('league/main/polls').child($pid).child('closed').val() !== true"
            }
          }
        },
        "tradeOffers": {
          ".read": "auth != null",
          "$oid": {
            ".write": "auth != null"
          }
        },
        "tradeVetoes": {
          ".read": "auth != null",
          "$oid": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'curtisawe@gmail.com' || root.child('admins').child(auth.uid).val() === true)"
            }
          }
        }
      }
    },
    "claims": {
      ".read": "auth != null",
      "$ti": {
        ".write": "auth != null && (auth.token.email === 'curtisawe@gmail.com' || root.child('admins').child(auth.uid).val() === true || ((!data.exists() || data.val() === auth.uid) && (!newData.exists() || newData.val() === auth.uid)))"
      }
    },
    "managers": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'curtisawe@gmail.com' || root.child('admins').child(auth.uid).val() === true)"
      }
    }
  }
}
